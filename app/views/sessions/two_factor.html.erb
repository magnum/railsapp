<div class="w-full max-w-sm mx-auto">
  <h1 class="text-2xl font-semibold text-gray-900 mb-6 text-center">
    <%= t("sessions.two_factor_title") %>
  </h1>

  <p class="mb-4 text-base text-gray-700"><%= t("sessions.two_factor_prompt") %></p>

  <%= form_with url: sign_in_two_factor_path, method: :post, data: { turbo: false }, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :otp_code, t("sessions.two_factor_code"), class: "block text-base font-medium text-gray-700 mb-1" %>
      <%= form.text_field :otp_code, required: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, autofocus: true, inputmode: "text", class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-center font-mono text-lg tracking-widest shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>
    <%= form.submit t("sessions.sign_in"), class: "btn-primary w-full" %>
  <% end %>
</div>
