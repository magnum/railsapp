<div class="w-full max-w-sm mx-auto">
  <h1 class="text-2xl font-semibold text-gray-900 mb-6 text-center">
    <%= t("sessions.magic_link_prompt_title") %>
  </h1>

  <p class="mb-4 text-base text-gray-700">
    <% if @email.present? %>
      <%= t("sessions.magic_link_prompt_intro", email: @email) %>
    <% else %>
      <%= t("sessions.magic_link_prompt_intro_generic") %>
    <% end %>
  </p>

  <ol class="mb-6 list-decimal space-y-2 pl-5 text-base text-gray-700">
    <li><%= t("sessions.magic_link_prompt_link") %></li>
    <li><%= t("sessions.magic_link_prompt_code") %></li>
  </ol>

  <%= form_with url: sign_in_magic_code_path, method: :post, data: { turbo: false }, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :code, t("sessions.magic_code"), class: "block text-base font-medium text-gray-700 mb-1" %>
      <%= form.text_field :code, required: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, autofocus: true, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-center font-mono text-lg tracking-widest shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>
    <%= form.submit t("sessions.sign_in"), class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-4 text-center text-base text-gray-600">
    <%= link_to t("sessions.back_to_sign_in"), sign_in_path, class: "font-medium text-gray-900 hover:text-gray-700" %>
  </p>
</div>
