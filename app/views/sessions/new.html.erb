<div class="w-full max-w-sm mx-auto">
  <h1 class="text-2xl font-semibold text-gray-900 mb-6 text-center">
    <%= t("sessions.sign_in") %>
  </h1>

  <%= form_with url: sign_in_path, method: :post, data: { turbo: false }, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email, t("registrations.email"), class: "block text-base font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>
    <div>
      <%= f.label :password, t("registrations.password"), class: "block text-base font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password", required: true, class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>
    <%= f.submit t("sessions.sign_in"), class: "btn-primary w-full" %>
    <% if email_magic_link_allowed? %>
      <%= f.submit t("sessions.email_magic_link"), name: "magic_link", formnovalidate: true, class: "btn-default w-full" %>
    <% end %>
  <% end %>

  <%= render "shared/oauth_buttons", i18n_scope: "sessions" %>

  <div class="mt-4" data-controller="passkey" data-passkey-options-url-value="<%= sign_in_passkey_options_path %>" data-passkey-sign-in-url-value="<%= sign_in_passkey_path %>" data-passkey-error-value="<%= t("sessions.passkey_invalid") %>">
    <button type="button" class="btn-default w-full" data-action="passkey#authenticate"><%= t("sessions.passkey") %></button>
    <p data-passkey-target="status" class="mt-2 text-center  text-red-700" aria-live="polite"></p>
  </div>

  <div class="mt-4">
    <%= render "shared/invitation_link" %>
  </div>

  <p class="mt-4 text-center text-base text-gray-600">
    <%= t("sessions.no_account") %>
    <%= link_to t("registrations.sign_up"), sign_up_path, class: "font-medium text-gray-900 hover:text-gray-700" %>
  </p>
</div>
