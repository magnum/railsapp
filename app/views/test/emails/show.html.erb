<div class="w-full max-w-lg mx-auto">
  <h1 class="text-2xl font-semibold text-gray-900 mb-6"><%= t("test_email.title") %></h1>

  <%= form_with url: test_email_path, method: :post, class: "space-y-4", data: { turbo_confirm: t("test_email.confirm") } do |form| %>
    <div>
      <%= form.label :email_to, t("test_email.email_to"), class: "block text-base font-medium text-gray-700 mb-1" %>
      <%= form.email_field :email_to, required: true, autocomplete: "email", value: params[:email_to], class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>
    <div>
      <%= form.label :text, t("test_email.text"), class: "block text-base font-medium text-gray-700 mb-1" %>
      <%= form.text_area :text, required: true, rows: 8, value: params[:text], class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>
    <%= form.submit t("test_email.send"), class: "btn-primary" %>
  <% end %>
</div>
