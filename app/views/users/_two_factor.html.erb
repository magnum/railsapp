<section class="mt-8 border-t border-gray-200 pt-6">
  <h3 class="text-lg font-semibold text-gray-900"><%= t("users.two_factor.title") %></h3>

  <% if backup_codes.present? %>
    <div class="mt-4" data-controller="clipboard" data-clipboard-copied="<%= t("users.two_factor.copied") %>">
      <p class="text-base text-gray-700"><%= t("users.two_factor.backup_intro") %></p>
      <pre data-clipboard-target="source" class="mt-3 overflow-x-auto rounded-md bg-gray-50 p-4 font-mono text-base tracking-widest text-gray-900"><%= backup_codes.join("\n") %></pre>
      <p data-clipboard-target="status" class="mt-2 text-sm text-gray-600" aria-live="polite"></p>
      <div class="mt-4 flex flex-wrap gap-3">
        <button type="button" class="btn-default" data-action="clipboard#copy"><%= t("users.two_factor.copy") %></button>
        <%= link_to t("users.two_factor.download"), backup_codes_user_two_factor_path(user, format: :txt), class: "btn-default", data: { turbo: false } %>
        <%= button_to t("users.two_factor.saved"), backup_codes_user_two_factor_path(user), method: :delete, class: "btn-primary", form: { data: { turbo: false } } %>
      </div>
    </div>
  <% elsif user.two_factor_active? %>
    <p class="mt-2 text-base text-gray-700"><%= t("users.two_factor.enabled_status") %></p>
    <%= button_to t("users.two_factor.disable"), user_two_factor_path(user), method: :delete, class: "btn-danger mt-4", form: { data: { turbo: false }, onsubmit: "return confirm(#{t("users.two_factor.disable_confirm").to_json})" } %>
  <% else %>
    <p class="mt-2 text-base text-gray-700"><%= t("users.two_factor.disabled_status") %></p>
    <div class="mt-4 flex flex-wrap gap-3" data-controller="dialog" data-dialog-open-value="<%= params[:two_factor] == "setup" && user.otp_pending_secret.present? %>">
      <%= button_to t("users.two_factor.create"), user_two_factor_path(user), method: :post, class: "btn-primary", form: { data: { turbo: false } } %>
      <% if user.otp_pending_secret.present? %>
        <button type="button" class="btn-default" data-action="dialog#open"><%= t("users.two_factor.show_qr") %></button>
        <dialog data-dialog-target="panel" class="two-factor-dialog rounded-lg shadow-xl">
          <div class="p-6">
            <div class="flex items-start justify-between gap-4">
              <h4 class="text-lg font-semibold text-gray-900"><%= t("users.two_factor.dialog_title") %></h4>
              <button type="button" class="text-gray-500 hover:text-gray-800" data-action="dialog#close" aria-label="<%= t("common.cancel") %>">×</button>
            </div>
            <ol class="mt-3 list-decimal space-y-1 pl-5 text-base text-gray-700">
              <li><%= t("users.two_factor.scan") %></li>
              <li><%= t("users.two_factor.enter_test_code") %></li>
            </ol>
            <div class="mt-4 flex justify-center"><%= user.otp_qr_svg %></div>
            <p class="mt-3 text-center font-mono text-sm tracking-widest text-gray-700"><%= user.formatted_otp_pending_secret %></p>
            <% if flash[:alert].present? && params[:two_factor] == "setup" %>
              <p class="mt-4 text-sm text-red-700"><%= flash[:alert] %></p>
            <% end %>
            <%= form_with url: confirm_user_two_factor_path(user), method: :post, data: { turbo: false }, class: "mt-4 space-y-4" do |form| %>
              <div>
                <%= form.label :otp_code, t("users.two_factor.test_code"), class: "block text-base font-medium text-gray-700 mb-1" %>
                <%= form.text_field :otp_code, required: true, autocomplete: "one-time-code", inputmode: "numeric", autofocus: true, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-center font-mono text-lg tracking-widest shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
              </div>
              <%= form.submit t("users.two_factor.confirm"), class: "btn-primary w-full" %>
            <% end %>
          </div>
        </dialog>
      <% end %>
    </div>
  <% end %>
</section>
