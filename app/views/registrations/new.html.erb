<div class="w-full max-w-sm mx-auto">
  <h1 class="text-2xl font-semibold text-gray-900 mb-6 text-center">
    <%= t("registrations.sign_up") %>
  </h1>

  <%= form_with model: @user, url: sign_up_path, method: :post, local: true, class: "space-y-4" do |f| %>
    <%= render "shared/error_messages", object: @user %>

    <div>
      <%= f.label :firstname, t("registrations.firstname"), class: "block text-base font-medium text-gray-700 mb-1" %>
      <%= f.text_field :firstname, autofocus: true, autocomplete: "given-name", required: true, class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>
    <div>
      <%= f.label :lastname, t("registrations.lastname"), class: "block text-base font-medium text-gray-700 mb-1" %>
      <%= f.text_field :lastname, autocomplete: "family-name", required: true, class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>
    <div>
      <%= f.label :email, t("registrations.email"), class: "block text-base font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, autocomplete: "email", required: true, class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>
    <div>
      <%= f.label :password, t("registrations.password"), class: "block text-base font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, autocomplete: "new-password", required: true, class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>
    <div>
      <%= f.label :password_confirmation, t("registrations.password_confirmation"), class: "block text-base font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" %>
    </div>
    <%= f.submit t("registrations.sign_up"), class: "btn-primary w-full" %>
  <% end %>

  <div class="mt-4">
    <%= render "shared/invitation_link" %>
  </div>

  <%= render "shared/oauth_buttons", i18n_scope: "registrations" %>

  <p class="mt-6 text-center text-base text-gray-600">
    <%= t("registrations.has_account") %>
    <%= link_to t("sessions.sign_in"), sign_in_path, class: "font-medium text-gray-900 hover:text-gray-700" %>
  </p>
</div>
